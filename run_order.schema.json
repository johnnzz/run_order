{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "https://github.com/johnnzz/run_order/run_order.schema.json",
    "title": "Run Order Timeseries",
    "description": "Schema for per-event timeseries JSON files used by the teams app. Version 2.0 uses a chronological entries log instead of timestamp-keyed location trees.",
    "type": "object",
    "required": [
        "schema_version",
        "event",
        "entries"
    ],
    "additionalProperties": false,
    "properties": {
        "schema_version": {
            "const": "2.0.0",
            "description": "Document format version."
        },
        "event": {
            "$ref": "#/$defs/event"
        },
        "entries": {
            "type": "array",
            "items": {
                "$ref": "#/$defs/timeseriesEntry"
            }
        }
    },
    "$defs": {
        "event": {
            "type": "object",
            "required": [
                "name"
            ],
            "additionalProperties": false,
            "properties": {
                "name": {
                    "type": "string",
                    "minLength": 1,
                    "description": "Event display name."
                },
                "dogsportphoto_code": {
                    "type": "string",
                    "pattern": "^\\d{4}$",
                    "description": "Optional four-digit DogSportPhoto event code. Used by the teams app and in on-disk filenames when present."
                },
                "org": {
                    "type": "string",
                    "minLength": 1,
                    "description": "Optional organization or sanctioning body. Used by the teams app when present."
                },
                "start_date": {
                    "type": "string",
                    "format": "date",
                    "description": "Optional inclusive event start date. Used by the teams app when present."
                },
                "end_date": {
                    "type": "string",
                    "format": "date",
                    "description": "Optional inclusive event end date. Used by the teams app when present."
                },
                "city": {
                    "type": "string",
                    "minLength": 1
                },
                "state": {
                    "type": "string",
                    "minLength": 1
                },
                "club": {
                    "type": "string",
                    "minLength": 1,
                    "description": "Hosting club name."
                },
                "venue": {
                    "type": "string",
                    "minLength": 1,
                    "description": "Venue name."
                },
                "org_type": {
                    "type": "string",
                    "minLength": 1,
                    "description": "Organization type, such as dock or dueling dogs."
                }
            }
        },
        "entryTimestamp": {
            "type": "string",
            "format": "date-time",
            "description": "ISO 8601 timestamp for when the entry was recorded."
        },
        "locationName": {
            "type": "string",
            "minLength": 1,
            "description": "Location or lane name, such as Dock 1 or Dock 1 Lane 2."
        },
        "handler": {
            "type": "object",
            "required": [
                "name"
            ],
            "additionalProperties": false,
            "properties": {
                "name": {
                    "type": "string",
                    "minLength": 1
                },
                "dogsportphoto_code": {
                    "type": "string",
                    "minLength": 1,
                    "description": "Registered handler entity code."
                },
                "email": {
                    "type": "string",
                    "minLength": 1
                },
                "phone": {
                    "type": "string",
                    "minLength": 1
                }
            }
        },
        "dog": {
            "type": "object",
            "required": [
                "name"
            ],
            "additionalProperties": false,
            "properties": {
                "name": {
                    "type": "string",
                    "minLength": 1
                },
                "dogsportphoto_code": {
                    "type": "string",
                    "minLength": 1,
                    "description": "Registered dog entity code."
                },
                "breed": {
                    "type": "string",
                    "minLength": 1
                },
                "color": {
                    "type": "string",
                    "minLength": 1
                },
                "org_ids": {
                    "type": "object",
                    "additionalProperties": {
                        "type": "string"
                    },
                    "description": "External organization identifiers keyed by org slug."
                }
            }
        },
        "team": {
            "type": "object",
            "required": [
                "name"
            ],
            "additionalProperties": false,
            "properties": {
                "name": {
                    "type": "string",
                    "minLength": 1,
                    "description": "Formatted handler-and-dog label used for photo keywording."
                },
                "dogsportphoto_code": {
                    "type": "string",
                    "minLength": 1,
                    "description": "Registered team entity code."
                }
            }
        },
        "attendance": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
                "photo_request": {
                    "type": "boolean",
                    "description": "Whether the handler requested event photos."
                },
                "message_to_photographer": {
                    "type": "string",
                    "maxLength": 200,
                    "description": "Optional one-line note from the handler to the photographer."
                }
            }
        },
        "camera": {
            "type": "object",
            "required": [
                "model",
                "serial"
            ],
            "additionalProperties": false,
            "properties": {
                "model": {
                    "type": "string",
                    "minLength": 1
                },
                "serial": {
                    "type": "string",
                    "minLength": 1
                }
            }
        },
        "photographer": {
            "type": "object",
            "required": [
                "name",
                "cameras"
            ],
            "additionalProperties": false,
            "properties": {
                "name": {
                    "type": "string",
                    "minLength": 1
                },
                "cameras": {
                    "type": "array",
                    "items": {
                        "$ref": "#/$defs/camera"
                    }
                }
            }
        },
        "teamCheckInEntry": {
            "type": "object",
            "required": [
                "at",
                "location",
                "type",
                "handler"
            ],
            "additionalProperties": false,
            "properties": {
                "at": {
                    "$ref": "#/$defs/entryTimestamp"
                },
                "location": {
                    "$ref": "#/$defs/locationName"
                },
                "type": {
                    "const": "team_check_in"
                },
                "handler": {
                    "$ref": "#/$defs/handler"
                },
                "dog": {
                    "$ref": "#/$defs/dog"
                },
                "team": {
                    "$ref": "#/$defs/team"
                },
                "event": {
                    "$ref": "#/$defs/attendance"
                }
            }
        },
        "photographerCheckInEntry": {
            "type": "object",
            "required": [
                "at",
                "location",
                "type",
                "photographer"
            ],
            "additionalProperties": false,
            "properties": {
                "at": {
                    "$ref": "#/$defs/entryTimestamp"
                },
                "location": {
                    "$ref": "#/$defs/locationName"
                },
                "type": {
                    "const": "photographer_check_in"
                },
                "photographer": {
                    "$ref": "#/$defs/photographer"
                }
            }
        },
        "setDisciplineEntry": {
            "type": "object",
            "title": "Set discipline",
            "description": "Records the active discipline at a location. Written by the teams app when a photographer or assistant selects a discipline.",
            "required": [
                "at",
                "location",
                "type",
                "discipline"
            ],
            "additionalProperties": false,
            "properties": {
                "at": {
                    "$ref": "#/$defs/entryTimestamp"
                },
                "location": {
                    "$ref": "#/$defs/locationName"
                },
                "type": {
                    "const": "set_discipline"
                },
                "discipline": {
                    "type": "string",
                    "minLength": 1,
                    "description": "Discipline name, such as Distance Jump or Speed Retrieve."
                }
            }
        },
        "timeseriesEntry": {
            "description": "A single chronological timeseries record.",
            "oneOf": [
                {
                    "$ref": "#/$defs/teamCheckInEntry"
                },
                {
                    "$ref": "#/$defs/photographerCheckInEntry"
                },
                {
                    "$ref": "#/$defs/setDisciplineEntry"
                }
            ]
        }
    }
}
