{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "https://github.com/johnnzz/run_order/run_order.schema.json",
    "title": "Run Order",
    "description": "Schema for run order / timeseries JSON files. Consumed by dogsport-photo-tools and other event workflow utilities. Documents store event metadata, check-ins, photographer setup, and discipline selection in a nested location tree keyed by venue name and timestamp.",
    "type": "object",
    "required": [
        "schema_version",
        "event",
        "location"
    ],
    "additionalProperties": false,
    "properties": {
        "schema_version": {
            "type": "string",
            "pattern": "^\\d+\\.\\d+\\.\\d+$",
            "description": "Semantic version of this document format. Current version is 2.0.0."
        },
        "event": {
            "$ref": "#/$defs/event"
        },
        "location": {
            "$ref": "#/$defs/locationNode"
        }
    },
    "$defs": {
        "timeseriesTimestamp": {
            "type": "string",
            "pattern": "^\\d{4}-\\d{2}-\\d{2} \\d{2}:\\d{2}:\\d{2}[+-]\\d{2}:\\d{2}$",
            "description": "UTC or zoned timestamp key used to order entries at a location."
        },
        "event": {
            "type": "object",
            "required": [
                "name",
                "start_date",
                "end_date"
            ],
            "additionalProperties": false,
            "properties": {
                "name": {
                    "type": "string",
                    "minLength": 1,
                    "description": "Event display name."
                },
                "org": {
                    "type": "string",
                    "minLength": 1,
                    "description": "Organization or sanctioning body."
                },
                "city": {
                    "type": "string",
                    "minLength": 1
                },
                "state": {
                    "type": "string",
                    "minLength": 1
                },
                "start_date": {
                    "type": "string",
                    "format": "date",
                    "description": "Inclusive event start date."
                },
                "end_date": {
                    "type": "string",
                    "format": "date",
                    "description": "Inclusive event end date."
                },
                "club": {
                    "type": "string",
                    "minLength": 1,
                    "description": "Hosting club name."
                },
                "venue": {
                    "type": "string",
                    "minLength": 1,
                    "description": "Venue name."
                },
                "org_type": {
                    "type": "string",
                    "minLength": 1,
                    "description": "Organization type, such as dock or dueling dogs."
                },
                "sheet_timezone": {
                    "type": "string",
                    "minLength": 1,
                    "description": "IANA timezone for naive Google Sheet timestamps."
                }
            }
        },
        "locationNode": {
            "type": "object",
            "description": "Nested map of location names to child nodes or timestamp slots. An empty object is valid for newly created event files.",
            "patternProperties": {
                "^\\d{4}-\\d{2}-\\d{2} \\d{2}:\\d{2}:\\d{2}[+-]\\d{2}:\\d{2}$": {
                    "type": "array",
                    "items": {
                        "$ref": "#/$defs/runEntry"
                    }
                }
            },
            "additionalProperties": {
                "$ref": "#/$defs/locationNode"
            }
        },
        "runEntry": {
            "description": "A single timeseries entry. Tools write handler metadata, team check-ins, photographer setup, and discipline selection records.",
            "oneOf": [
                {
                    "title": "Handler metadata",
                    "type": "object",
                    "required": [
                        "handler"
                    ],
                    "not": {
                        "required": [
                            "dog"
                        ]
                    },
                    "additionalProperties": false,
                    "properties": {
                        "group": {
                            "type": "string"
                        },
                        "handler": {
                            "type": "string",
                            "minLength": 1,
                            "description": "Handler display name, optionally with an entity code suffix."
                        },
                        "handler-email": {
                            "type": "string",
                            "minLength": 1
                        },
                        "handler-phone": {
                            "type": "string",
                            "minLength": 1
                        },
                        "photo_request": {
                            "type": "string",
                            "enum": [
                                "Yes",
                                "No"
                            ],
                            "description": "Whether the handler requested event photos."
                        },
                        "user_id": {
                            "type": "string",
                            "format": "uuid",
                            "description": "Registered handler user id when known."
                        }
                    }
                },
                {
                    "title": "Team check-in",
                    "type": "object",
                    "required": [
                        "dog",
                        "handler"
                    ],
                    "additionalProperties": false,
                    "properties": {
                        "group": {
                            "type": "string"
                        },
                        "dog": {
                            "$ref": "#/$defs/dog"
                        },
                        "handler": {
                            "type": "string",
                            "minLength": 1,
                            "description": "Handler display name, optionally with an entity code suffix."
                        },
                        "handler-email": {
                            "type": "string",
                            "minLength": 1
                        },
                        "handler-phone": {
                            "type": "string",
                            "minLength": 1
                        },
                        "photo_request": {
                            "type": "string",
                            "enum": [
                                "Yes",
                                "No"
                            ],
                            "description": "Whether the handler requested event photos."
                        },
                        "team": {
                            "type": "string",
                            "minLength": 1,
                            "description": "Formatted handler-and-dog team label used for photo keywording."
                        },
                        "user_id": {
                            "type": "string",
                            "format": "uuid",
                            "description": "Registered handler user id when known."
                        }
                    }
                },
                {
                    "title": "Photographer setup",
                    "type": "object",
                    "required": [
                        "photographer",
                        "cameras"
                    ],
                    "additionalProperties": false,
                    "properties": {
                        "photographer": {
                            "type": "string",
                            "minLength": 1
                        },
                        "cameras": {
                            "type": "array",
                            "description": "Cameras registered for this photographer at the location.",
                            "items": {
                                "$ref": "#/$defs/camera"
                            }
                        }
                    }
                },
                {
                    "title": "Discipline selection",
                    "type": "object",
                    "required": [
                        "discipline"
                    ],
                    "additionalProperties": false,
                    "properties": {
                        "discipline": {
                            "type": "string",
                            "minLength": 1
                        }
                    }
                }
            ]
        },
        "camera": {
            "type": "object",
            "required": [
                "model",
                "serial"
            ],
            "additionalProperties": false,
            "properties": {
                "model": {
                    "type": "string",
                    "minLength": 1
                },
                "serial": {
                    "type": "string",
                    "minLength": 1
                }
            }
        },
        "dog": {
            "type": "object",
            "required": [
                "call_name"
            ],
            "additionalProperties": false,
            "properties": {
                "call_name": {
                    "type": "string",
                    "minLength": 1,
                    "description": "Dog call name, optionally with an entity code suffix."
                },
                "breed": {
                    "type": "string",
                    "minLength": 1
                },
                "color": {
                    "type": "string",
                    "minLength": 1
                },
                "org_ids": {
                    "type": "object",
                    "additionalProperties": {
                        "type": "string"
                    }
                }
            }
        }
    }
}
